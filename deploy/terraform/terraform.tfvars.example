# Copy to terraform.tfvars (git-ignored). Everything is optional; defaults are in variables.tf.
# Keys and tokens (SECRET_KEY, Fernet keys, MCP_SERVICE_KEY, METRICS_TOKEN) are generated by Terraform in secrets.tf.

github_repo       = "ceoandchairman-ui/MasterProDev_MCP_AI_Agent"
github_branch     = "ai-agent-mpd-dev-branch"
backend_subdomain = "mpd-assistant-backend"

# Leave unset until a read-only Postgres role exists; mcp-db is only created when this is set.
# mcp_db_url = "postgresql://readonly_user:...@postgres.railway.internal:5432/mpd"

# huggingface_api_key = "hf_..."

model_settings = {
  # HUGGINGFACE_MODEL    = "..."
  # LLM_MODEL_CHEAP      = "..."
  # LLM_MODEL_REASONING  = "..."
  # LLM_MODEL_COMPRESS   = "..."
}

