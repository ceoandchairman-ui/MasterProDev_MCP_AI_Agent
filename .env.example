# Copy to .env and fill in. Never commit .env.

# Server
ENV=development
DEBUG=True
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
PUBLIC_DOMAIN=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:8000","http://localhost:3000"]
SECRET_KEY=change-me

# Admin (staff login)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Local docker compose only (docker/docker-compose.yml)
DEV_PASSWORD=change-me

# Database and Redis
DATABASE_URL=postgresql://user:password@localhost:5432/mpd_assistant
REDIS_URL=redis://:password@localhost:6379/0
REDIS_PASSWORD=password
REDIS_HOST=localhost
REDIS_PORT=6379

# LLM provider: huggingface | bedrock | ollama
ACTIVE_LLM_PROVIDER=huggingface
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL=amazon.nova-pro-v1:0

# MCP tool servers (use private Railway hostnames in production)
CALENDAR_SERVER_URL=http://localhost:8001
GMAIL_SERVER_URL=http://localhost:8002
DB_SERVER_URL=http://localhost:8004
MCP_SERVICE_KEY=change-me

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Weaviate and knowledge base
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051
KNOWLEDGE_BASE_PATH=./Company_Documents
EMBEDDING_MODEL=BAAI/bge-m3

# Outbound messaging and inbound channels (Twilio: SMS and WhatsApp; SendGrid: email)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
SENDGRID_API_KEY=
EMAIL_FROM=
MESSAGES_DAILY_CAP=500

# Knowledge retrieval (pgvector + BM25). Needs a Postgres with the vector extension.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
RETRIEVAL_MIN_SCORE=0.35

# Where the assistant sends escalations (placeholder until a team inbox exists)
ESCALATION_EMAIL=

# Optional hosted reranker (Cohere-compatible); the cutoff differs from the embedding cutoff
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=rerank-multilingual-v3.0
RERANK_MIN_SCORE=0.3

# Spend protection: daily model tokens per conversation and for the whole service (placeholders)
SESSION_DAILY_TOKENS=60000
GLOBAL_DAILY_TOKENS=2000000

# Service catalog for quotes (YAML with an items list); quotes are disabled when unset
CATALOG_PATH=

# Migration flag: route /chat to the new LangGraph pipeline
USE_NEW_PIPELINE=false

# --- New pipeline: keys and secrets (generate fresh values per environment; never reuse these placeholders) ---
DATA_ENCRYPTION_KEY=generate-with-scripts-or-core.crypto.generate_key
DATA_ENCRYPTION_KEYS_PREVIOUS=
BLIND_INDEX_KEY=generate-with-core.crypto.generate_key
METRICS_TOKEN=change-me
ADMIN_TOKEN=change-me-staff-console-and-admin-routes
EMAIL_INBOUND_TOKEN=change-me-secret-in-the-sendgrid-webhook-urls

# --- Models, embeddings, speech and vision ---
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL_CHEAP=
LLM_MODEL_REASONING=
LLM_MODEL_COMPRESS=
JUDGE_SAMPLE_RATE=0.2
AUDIO_BASE_URL=
AUDIO_API_KEY=
STT_MODEL=whisper-1
TTS_MODEL=tts-1
VISION_MODEL=
OCR_ENGINE=none

# --- Cache, retention, rollout ---
REDIS_CACHE_URL=
CACHE_ENABLED=true
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.92
PROMPT_VERSION=v1
CORPUS_VERSION=1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
CONVERSATION_RETENTION_DAYS=365
GUEST_RETENTION_DAYS=30
SMS_ALLOWED_COUNTRIES=CA,US
NEW_PIPELINE_PERCENT=0

# --- Edge ---
TRUSTED_PROXY_HOPS=1
EDGE_REQUESTS_PER_MINUTE=120
CORS_ORIGINS=

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_RETURN_URL=

# --- Staff console links ---
GRAFANA_URL=
LANGSMITH_URL=

# Embeddings: auto picks the HuggingFace feature-extraction format when EMBEDDING_BASE_URL is empty or points at hf-inference
EMBEDDING_FORMAT=auto

# --- Resilience and limits ---
TURN_TIMEOUT_SECONDS=45
GRAPH_RECURSION_LIMIT=30
THREADPOOL_SIZE=64
TOOL_TIMEOUT_SECONDS=15
TOOL_MAX_RETRIES=2
TOOL_MAX_CONCURRENCY=16
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=8

# --- Per-tier model endpoints (empty means LLM_BASE_URL and HUGGINGFACE_API_KEY) and fallbacks ---
LLM_COMPRESS_BASE_URL=
LLM_COMPRESS_API_KEY=
LLM_CHEAP_BASE_URL=
LLM_CHEAP_API_KEY=
LLM_MID_BASE_URL=
LLM_MID_API_KEY=
LLM_REASONING_BASE_URL=
LLM_REASONING_API_KEY=
LLM_FALLBACK_CHEAP=
LLM_FALLBACK_MID=
LLM_FALLBACK_REASONING=
LLM_FALLBACK_COMPRESS=
