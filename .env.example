# Environment (development, staging, production)
ENV=development
DEBUG=True
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Server
PUBLIC_DOMAIN=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:8000", "http://localhost:3000"]
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mpd_assistant

# Redis (checkpoints and session cache)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379

# Redis (cache layer, optional separate instance)
REDIS_CACHE_URL=redis://localhost:6380/0

# LLM Providers
ACTIVE_LLM_PROVIDER=claude  # Options: claude, huggingface, bedrock, ollama
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-20241022

# AWS Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL=amazon.nova-pro-v1:0

# Authentication
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_EMAIL=admin@masterprodev.com
ADMIN_PASSWORD=change-this-in-production

# MCP Servers (service-to-service URLs for Railway)
CALENDAR_SERVER_URL=http://mcp-calendar.railway.internal:8000
GMAIL_SERVER_URL=http://mcp-gmail.railway.internal:8000
DB_SERVER_URL=http://mcp-db.railway.internal:8000
QUOTING_SERVER_URL=http://mcp-quoting.railway.internal:8000

# Service-to-service authentication
MCP_SERVICE_KEY=your-service-auth-key

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Weaviate (document retrieval)
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051

# Knowledge base
KNOWLEDGE_BASE_PATH=./knowledge/company_documents
EMBEDDING_MODEL=BAAI/bge-m3

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mpd-assistant
PROMETHEUS_SCRAPE_PORT=9090

# Email (OTP and transactional)
EMAIL_PROVIDER=sendgrid  # or: resend, mailgun
SENDGRID_API_KEY=
EMAIL_FROM=noreply@masterprodev.com

# SMS (OTP verification)
SMS_PROVIDER=twilio  # or: aws_sns
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# PII and privacy
PII_SCANNER_LANGUAGES=en,fr
PII_VAULT_ENCRYPTION_KEY=
FALLBACK_PII_SCANNER=regex  # Fast fallback if Presidio is slow

# Feature flags
USE_STRANGLER_MIGRATION=False
